---
/**
 * DataTableBody Component
 *
 * @description Table body wrapper for DataTable rows
 */

interface Props {
  /**
   * Additional classes to apply to the table body
   */
  class?: string
  /**
   * HTML attributes to spread on the table body
   */
  [key: string]: string | number | boolean | undefined
}

const { class: className, ...rest } = Astro.props
---

<tbody class:list={['data-table__body', className]} {...rest}>
  <slot />
</tbody>
