{
  "name": "accessible-astro-components",
  "description": "A comprehensive set of accessible, easy-to-use UI components for Astro websites, built with WCAG compliance and inclusive design principles.",
  "version": "5.8.0",
  "author": "Incluud",
  "license": "MIT",
  "homepage": "https://accessible-astro.incluud.dev/components/overview/",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./src/types/index.d.ts",
        "default": "./index.js"
      }
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./src/types/index.d.ts",
  "files": [
    "index.js",
    "src/components",
    "src/styles",
    "src/types",
    "README.md",
    "LICENSE",
    "!**/*.stories.ts",
    "!src/components/StorySlot.astro",
    "!src/components/StorySlotChildren.astro",
    "!src/styles/astrobook.css"
  ],
  "keywords": [
    "astro",
    "astro-component",
    "astro-components",
    "accessible",
    "accessibility",
    "a11y",
    "wcag",
    "responsive",
    "ui-library",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incluud/accessible-astro-components.git"
  },
  "bugs": {
    "url": "https://github.com/incluud/accessible-astro-components/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "astro": "^7.0.0",
    "astrobook": "^0.12.2",
    "prettier": "2.8.7",
    "prettier-plugin-astro": "^0.8.0",
    "prettier-plugin-css-order": "^1.3.1"
  },
  "engines": {
    "node": "^18.20.8 || ^20.3.0 || >=22.0.0"
  }
}
